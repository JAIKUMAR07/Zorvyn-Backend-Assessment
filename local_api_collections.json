    {
      "name": "💰 3. Financial Records (CRUD)",
      "item": [
        {
          "name": "3.1 Create Record (Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (pm.response.code === 201 && response.data?.record?._id) {",
                  "    pm.environment.set(\"record_id\", response.data.record._id);",
                  "    console.log(\"✅ Record created! ID saved.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50000,\n  \"type\": \"income\",\n  \"category\": \"Salary\",\n  \"description\": \"April salary\",\n  \"date\": \"2026-04-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
