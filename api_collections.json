    {
      "name": "💰 3. Financial Records (CRUD)",
      "item": [
        {
          "name": "3.1 Create Record (Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (pm.response.code === 201 && response.data?.record?._id) {",
                  "    pm.environment.set(\"record_id\", response.data.record._id);",
                  "    console.log(\"✅ Record created! ID saved.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 75000,\n  \"type\": \"income\",\n  \"category\": \"Product Sales\",\n  \"description\": \"Q2 product sales revenue\",\n  \"date\": \"2026-04-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/records"
          }
        },
        {
          "name": "3.2 Get All Records (With Pagination)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/api/v1/records?page=1&limit=10"
          }
        },
        {
          "name": "3.3 Filter by Type - Income",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/api/v1/records?type=income"
          }
        },
        {
          "name": "3.4 Filter by Type - Expense",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/api/v1/records?type=expense"
          }
        },
        {
          "name": "3.5 Filter by Business Category",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/api/v1/records?category=Software%20Licenses"
          }
        },
        {
          "name": "3.6 Search by Description",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/api/v1/records?search=marketing"
          }
        },
        {
          "name": "3.7 Date Range Filter",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/api/v1/records?fromDate=2026-01-01&toDate=2026-03-31"
          }
        },
        {
          "name": "3.8 Combined Filters",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/api/v1/records?type=expense&category=Marketing%20Ads&fromDate=2026-01-01&toDate=2026-06-30&page=1&limit=20"
          }
        },
        {
          "name": "3.9 Get Single Record",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/api/v1/records/{{record_id}}"
          }
        },
        {
          "name": "3.10 Update Record (Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 85000,\n  \"description\": \"Q2 product sales revenue (updated)\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/records/{{record_id}}"
          }
        },
        {
          "name": "3.11 Delete Record (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "{{base_url}}/api/v1/records/{{record_id}}"
          }
        }
      ]
    },
