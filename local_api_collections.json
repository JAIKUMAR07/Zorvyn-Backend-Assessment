    {
      "name": "🔐 2. Authentication",
      "item": [
        {
          "name": "2.1 Register User (Auto: Viewer Role)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (pm.response.code === 201 && response.token) {",
                  "    pm.environment.set(\"auth_token\", response.token);",
                  "    console.log(\"✅ Registration successful! Token saved.\");",
                  "    console.log(\"Role: viewer (default)\");",
                  "} else if (pm.response.code === 400 && response.message?.includes('exists')) {",
                  "    console.log(\"⚠️ User already exists. Login instead.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/auth/signup"
