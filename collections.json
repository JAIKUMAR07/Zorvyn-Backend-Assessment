{
  "info": {
    "name": "Ultimate Finance Backend Collection",
    "description": "Exhaustive collection for all Finance Backend features with auto-authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User (Default: Viewer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response && response.token) {",
                  "    pm.environment.set(\"auth_token\", response.token);",
                  "    console.log(\"✅ Account Created - Token Saved\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Testing User\",\n  \"email\": \"test@user.com\",\n  \"password\": \"password123\"\n}",
              "options": { "json": { "language": "json" } }
            },
            "url": "http://localhost:5000/api/v1/auth/signup"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response && response.token) {",
                  "    pm.environment.set(\"auth_token\", response.token);",
                  "    console.log(\"✅ Login Successful - Token Refreshed\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@user.com\",\n  \"password\": \"password123\"\n}",
              "options": { "json": { "language": "json" } }
            },
            "url": "http://localhost:5000/api/v1/auth/login"
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "http://localhost:5000/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "2. Financial Records (CRUD)",
      "item": [
        {
          "name": "Create Record (Admin Only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 8000,\n  \"type\": \"income\",\n  \"category\": \"Bonus\",\n  \"description\": \"Year-end performance bonus\",\n  \"date\": \"2026-04-01\"\n}",
              "options": { "json": { "language": "json" } }
            },
            "url": "http://localhost:5000/api/v1/records"
          }
        },
        {
          "name": "Get All Records (With Filters)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/records?type=income&category=Salary&sort=-amount",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "v1", "records"],
              "query": [
                { "key": "type", "value": "income" },
                { "key": "category", "value": "Salary" },
                { "key": "sort", "value": "-amount" }
              ]
            }
          }
        },
        {
          "name": "Get Single Record",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "http://localhost:5000/api/v1/records/RECORD_ID"
          }
        },
        {
          "name": "Update Record (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 8500\n}",
              "options": { "json": { "language": "json" } }
            },
            "url": "http://localhost:5000/api/v1/records/RECORD_ID"
          }
        },
        {
          "name": "Delete Record (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "http://localhost:5000/api/v1/records/RECORD_ID"
          }
        }
      ]
    },
    {
      "name": "3. Dashboard & Analytics",
      "item": [
        {
          "name": "Financial Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "http://localhost:5000/api/v1/dashboard/summary"
          }
        },
        {
          "name": "Monthly Trends (Analyst/Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "http://localhost:5000/api/v1/dashboard/trends"
          }
        },
        {
          "name": "Category Wise Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "http://localhost:5000/api/v1/dashboard/category-stats"
          }
        },
        {
          "name": "Recent 10 Activities",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "http://localhost:5000/api/v1/dashboard/recent"
          }
        }
      ]
    },
    {
      "name": "4. Admin: User Control",
      "item": [
        {
          "name": "List All Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": "http://localhost:5000/api/v1/users"
          }
        },
        {
          "name": "Upgrade User Role",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\"\n}",
              "options": { "json": { "language": "json" } }
            },
            "url": "http://localhost:5000/api/v1/users/USER_ID"
          }
        },
        {
          "name": "Toggle Inactive/Active Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}",
              "options": { "json": { "language": "json" } }
            },
            "url": "http://localhost:5000/api/v1/users/status/USER_ID"
          }
        }
      ]
    },
    {
      "name": "5. Public Utilities",
      "item": [
        {
          "name": "Health Check (v1)",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/v1/health"
          }
        },
        {
          "name": "Backend Root",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/"
          }
        }
      ]
    }
  ]
}
