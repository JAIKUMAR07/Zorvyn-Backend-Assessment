    {
      "name": "⚠️ 8. Error Handling Tests",
      "item": [
        {
          "name": "8.1 Invalid Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"wrong@email.com\",\n  \"password\": \"wrongpassword\"\n}",
